@{
    ViewBag.Title = "ShoppingCart";
}


<div class="card w-100 border-0 rounded-0">

    <!--begin::Card header-->
    <div class="card-header pe-5" style="width:100%">
        <!--begin::Title-->
        <div class="card-title" style="width:100%">
            <!--begin::User-->
            <div class="d-flex justify-content-center flex-column me-3" style="width:100%;text-align:right">
                <h3>عربة التسوق </h3> 
                <!--end::Info-->
            </div>
            <!--end::User-->
        </div>
        <!--end::Title-->

    </div>
    <!--end::Card header-->
    <div id="CartDivDetails" style="display:none">
        <!--begin::Card body-->
        <div class="card-body">
            <!--begin::Messages-->

            <section class="h-100 h-custom">
                <div class="container h-100 py-5">
                    <div class="row d-flex justify-content-center align-items-center">
                        <div class="col">

                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="h5"><h5>غلاف الكتاب</h5> </th>
                                            <th scope="col"><h5>اسم الكتاب</h5></th>
                                            <th scope="col"><h5>الكمية</h5></th>
                                            <th scope="col" id="SupportedCopy"><h5>سعر النسخة المدعومه</h5></th>
                                            <th scope="col" id="PriceOtherCopies"><h5>سعر باقى النسخ</h5></th>
                                            <th scope="col"><h5>حذف</h5></th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbody_cart_Details">
                                    </tbody>
                                </table>
                             
                             
                            </div>

                            <div class="card shadow-2-strong mb-5 mb-lg-0" style="border-radius: 16px;">
                                <div class="card-body p-4">
                                     <div class="row mb-6">
                                        <!--begin::Label-->
                                         <h3>ملحوظة: </h3>
                                         <label class="col-lg-8 col-form-label fw-semibold fs-6" id="txt_notes">
                                             
                                         </label>
                                    </div>
                                    <div class="row mb-6">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 col-form-label fw-semibold fs-6">
                                            السعر قبل الدعم
                                        </label>

                                        <div class="col-lg-6 fv-row">
                                            <label class="form-control form-control-sm" type="text" id="txt_TotalPrice"></label>
                                        </div>

                                        <!--end::Col-->
                                    </div>
                                    <div class="row mb-6">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 col-form-label fw-semibold fs-6">
                                            السعر بعد الدعم
                                        </label>

                                        <div class="col-lg-6 fv-row">
                                            <label class="form-control form-control-sm" type="text" id="txt_PriceAfterDiscout"></label>
                                        </div>

                                        <!--end::Col-->
                                    </div>
                                    <div class="row mb-6">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 col-form-label fw-semibold fs-6">
                                            مكان الاستلام
                                            <span class="required"></span>
                                        </label>

                                        <div class="col-lg-8 fv-row">
                                            <i class="fa"></i>
                                            <select class="form-select form-select-solid" data-control="select2" data-placeholder="اختر" id="ddl_DeliveryPlace">
                                                <option value="-1">اختر</option>
                                            </select>
                                        </div>

                                        <!--end::Col-->
                                    </div>
                                    <div class="row mb-6">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 col-form-label fw-semibold fs-6">
                                            ساعة الاستلام
                                            <span class="required"></span>
                                        </label>

                                        <div class="col-lg-8 fv-row">
                                            <i class="fa"></i>
                                            <select class="form-select form-select-solid" data-control="select2" data-placeholder="اختر" id="ddl_DeliverHour">
                                                <option value="09:00">09:00</option>
                                                <option value="10:00">10:00</option>
                                                <option value="11:00">11:00</option>
                                                <option value="12:00">12:00</option>
                                                <option value="13:00">13:00</option>
                                                <option value="14:00">14:00</option>
                                                <option value="15:00">15:00</option>
                                                <option value="16:00">16:00</option>
                                                <option value="17:00">17:00</option>
                                                <option value="18:00">18:00</option>
                                                <option value="19:00">19:00</option>
                                                <option value="20:00">20:00</option>
                                                <option value="21:00">21:00</option>
                                            </select>
                                        </div>

                                        <!--end::Col-->
                                    </div>
                                    <div class="row mb-6">
                                        <!--begin::Label-->
                                        <label class="col-lg-4 col-form-label fw-semibold fs-6">
                                            تاريخ الاستلام
                                            <span class="required"></span>
                                        </label>

                                        <div class="col-lg-8 fv-row">
                                            <input class="form-control form-control-solid" placeholder="Pick date rage" id="kt_daterangepicker_3" />
                                        </div>

                                        <!--end::Col-->
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </section>




            <!--end::Messages-->
        </div>
        <!--end::Card body-->
        <!--begin::Card footer-->
        <div class="card-footer pt-4">
            <!--begin::Input-->
            <!--end::Input-->
            <!--begin:Toolbar-->
            <div class="d-flex flex-stack" style="justify-content:center">


                <!--begin::Send-->
                <button class="btn btn-danger" type="button" data-kt-element="send" style="width:60%" onclick="ShoppingCart.FinidhShop()">
                    اشترى الان <i class="ki-duotone ki-purchase fs-2 fs-lg-1">
                        <i class="path1"></i>
                        <i class="path2"></i>
                    </i>
                </button>
                <!--end::Send-->
            </div>
            <!--end::Toolbar-->
        </div>
    </div>
    <div id="EmptyCartDetails" style="text-align: center;display:none">
        <img src="~/assets/empty.png" style="width:400px;height:400px">
        <h3 style="margin-top:30px;text-align:center;width:100%">عربة التسوق فارغة</h3>
        <a href="@Url.Action("Index", "Home")">
            <button class="btn btn-danger" type="button" data-kt-element="send" style="width:60%;margin-top:30px;margin-bottom:30px" onclick="RedirectToAdd()">
                العودة الى قائمة الشراء <i class="ki-duotone ki-purchase fs-2 fs-lg-1">
                    <i class="path1"></i>
                    <i class="path2"></i>
                </i>
            </button>
            </a>
    </div>
    <!--end::Card footer-->
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/Home/ShoppingCart.js"></script>
