                </div>
            </div>


            <div class="col-md-4">
                <div class="form-group">

                    <label class="form-label">
                        الناشر
                    </label>

                    <input class="form-control form-control-sm" type="text" id="txt_bookPublisher" />

                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="form-label">
                        المؤلف
                    </label>
                    <input class="form-control form-control-sm" type="text" id="txt_bookAuthor" />
                </div>
            </div>

        </div>
        <div class="row alight-items-center">
            <div class="col-md-4"></div>
            <div class="col-md-4">

                <div class="form-group">
                    <button class="btn btn-danger col-md-12" type="button" id="Button1" runat="server" onclick="PurchaseBook.search()" style="margin-top: 20px">
                        بحث
