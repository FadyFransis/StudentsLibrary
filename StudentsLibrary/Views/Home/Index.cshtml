        <div class=" row">
            <div class="col-md-4">
                <div class="form-group">
                    <label class="form-label">
                        المخزن
                    </label>
                    <select class="form-select" data-control="select2" data-placeholder="اختر" id="ddl_DeliveryPlace"></select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">

                    <label class="form-label">
                        كود الكتاب
                    </label>


                    <input class="form-control form-control-sm" type="text" id="txt_bookId">

                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">

                    <label class="form-label">
                        اسم الكتاب
                    </label>


                    <input class="form-control form-control-sm" type="text" id="txt_bookName">

                </div>
            </div>
        </div>
        <div class="row">





            <div class="col-md-4">
