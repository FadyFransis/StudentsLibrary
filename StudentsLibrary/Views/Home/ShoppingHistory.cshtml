
@{
    ViewBag.Title = "ShoppingHistory";
}
<div class="card w-100 border-0 rounded-0">

    <!--begin::Card header-->
    <div class="card-header pe-5" style="width:100%">
        <!--begin::Title-->
        <div class="card-title" style="width:100%">
            <!--begin::User-->
            <div class="d-flex justify-content-center flex-column me-3" style="width:100%;text-align:right">
               <h3>عمليات الشراء السابقة</h3>
                <!--end::Info-->
            </div>
            <!--end::User-->
        </div>
        <!--end::Title-->

    </div>
    <!--end::Card header-->
    <div id="CartDivDetails">
        <!--begin::Card body-->
        <div class="card-body">
            <!--begin::Messages-->
                <div class="container h-100 py-5">
                    <div class="row d-flex justify-content-center align-items-center">
                        <div class="accordion" id="dv_ShoppingHistory">

                           
                        </div>

                    </div>
                </div>
            <!--end::Messages-->
        </div>
        <!--end::Card body-->
        <!--begin::Card footer-->
    </div>
    <div id="EmptyCartDetails" style="text-align: center;display:none">
        <img src="../assets/empty.png" style="width:400px;height:400px">
        <h3 style="margin-top:30px;text-align:center;width:100%">عربة التسوق فارغة</h3>
        <button class="btn btn-primary" type="button" data-kt-element="send" style="width:60%;margin-top:30px;margin-bottom:30px" onclick="RedirectToAdd()">
            اضافة كتب <i class="ki-duotone ki-purchase fs-2 fs-lg-1">
                <i class="path1"></i>
                <i class="path2"></i>
            </i>
        </button>
    </div>
    <!--end::Card footer-->
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
