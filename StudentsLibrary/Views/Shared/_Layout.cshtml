    <script>
        function LogOut() {
            localStorage.clear();
            window.location.href = "logout/Logout"
        }
        $(document).ready(function () {
            $.ajax({
                type: "POST",
                url: "Home/GetSettings",
                data: null,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                cache: false,
                success: function (result) {
                    document.querySelector(`[id$='IsSingleCopy']`).value = result[0].Is_One_Copy;
                }
            });
        })
        function OpenCart() {
            if (localStorage.Cart == undefined) {
                document.getElementById("EmptyCart").style.display = ""
                document.getElementById("CartDiv").style.display = "none"
                document.getElementById("kt_drawer_chat_messenger_footer").style.display = "none"
            }
            else {
                document.getElementById("EmptyCart").style.display = "none"
                document.getElementById("CartDiv").style.display = ""
                document.getElementById("kt_drawer_chat_messenger_footer").style.display = ""
            }
            if (localStorage.Cart != undefined) {
                var Cart = JSON.parse(localStorage.Cart);
                if (Cart.length == 0) {
                    document.getElementById("EmptyCart").style.display = ""
                    document.getElementById("CartDiv").style.display = "none"
                    document.getElementById("kt_drawer_chat_messenger_footer").style.display = "none"

                }
                else {
                    document.getElementById("kt_drawer_chat_messenger_footer").style.display = ""
                    var IsSingleCopy = document.querySelector(`[id$='IsSingleCopy']`).value;
                    document.getElementById("tbody_cart").innerHTML = ""
                    for (var i = 0; i < Cart.length; i++) {
                        var Script = "";
                        Script += "<tr BookId = " + Cart[i].BookId + ">" +
                            "<th scope = 'row'>" +
                            "<div class='d-flex align-items-center' style='justify-content: center;'>" +
                            "<img src='" + Cart[i].BookImage +"' class='img-fluid rounded-3' style='width: 120px;' alt='Book'>" + "</div>" +
                            "</th>" +
                            "<td class='align-middle' style='text-align: center;'>" +
                            "<p class='mb-0' style='font-weight: 500;'>" + Cart[i].BookName + "</p>" +
                            "</td>" +
                            "<td class='align-middle'>" +
                            " <div class='d-flex flex-row' style='align-items: center;justify-content: center;'>";
                        if (IsSingleCopy == "0") {
                            Script += "<button class='btn btn-link px-2' onclick='this.parentNode.querySelector(`input[type=number]`).stepUp();ChangeQuantity(" + Cart[i].BookId + ",this.parentNode.querySelector(`input[type = number]`).value)'>" +
                                "<i class='fas fa-plus'></i>" +
                                " </button>" +
                                " <input id='form1' disabled onChange='ChangeQuantity(" + Cart[i].BookId + ",this.parentNode.querySelector(`input[type = number]`).value)' min='0' name='quantity' value='" + Cart[i].BookQuantity + "' type='number' class='form-control form-control-sm'style='width: 50px' />" +
                                "<button class='btn btn-link px-2'" +
                                "onclick ='StepDownClick(this);ChangeQuantity(" + Cart[i].BookId + ",this.parentNode.querySelector(`input[type = number]`).value)' > " +
                                "<i class='fas fa-minus'></i>" +
                                "</button>";
                        }
                        else {
                            Script += "<p class='mb-0' style='font-weight: 500'>" + Cart[i].BookQuantity + "</p>"
                        }
                        Script += "</div > " +
                            "</td>" +
                            //"<td class='align-middle'>" +
                            //"<p class='mb-0' style='font-weight: 500'>" + Cart[i].BookPrice + "</p>" +
                            //"</td>" +
                            "<td class='align-middle'>" +
                            "<button class='btn btn-danger rounded - 0' onclick='Delete(event," + Cart[i].BookId + ")'><i class='fa-solid fa-trash'></i></button>";
                        "</td>" +
                            "</tr>";
                        document.getElementById("tbody_cart").innerHTML += Script
                    }
                }
            }
        }
        function ChangeQuantity(Id, Quantity) {
            var Cart = JSON.parse(localStorage.Cart);
            for (var i = 0; i < Cart.length; i++) {
                if (Cart[i].BookId == Id) {
                    Cart[i].BookQuantity = Quantity
                    localStorage.setItem('Cart', JSON.stringify(Cart));
                    return;
                }
            }

        }
        function StepDownClick(ele) {
            if (ele.parentNode.querySelector(`input[type=number]`).value > 1)
                ele.parentNode.querySelector(`input[type=number]`).stepDown();
        }
        function Delete(event, Id) {
            var Cart = JSON.parse(localStorage.Cart);
            for (var i = 0; i < Cart.length; i++) {
                if (Cart[i].BookId == Id) {
                    Cart.splice(i, 1);
                    localStorage.setItem('Cart', JSON.stringify(Cart));
                }
            }
            var SelectedRow = event.target.closest("tr");
            SelectedRow.remove();
            if (Cart.length == 0) {
                document.getElementById("EmptyCart").style.display = ""
                document.getElementById("CartDiv").style.display = "none"
                document.getElementById("kt_drawer_chat_messenger_footer").style.display = "none"
            }

        }
        function Notification_success(Notice, flag) {


           
                if (flag == "true") {
                    Swal.fire({
                        text: Notice,
                        icon: "success",
                        buttonsStyling: !1,
                        confirmButtonText: "حسنًا ، موافق.",
                        customClass: {
                            confirmButton: "btn fw-bold btn-primary",
                        },                        
                    })
                }
                else {
                    Swal.fire({
                        text: Notice,
                        icon: "error",
                        buttonsStyling: !1,
                        confirmButtonText: "حسنًا ، موافق.",
                        customClass: {
                            confirmButton: "btn fw-bold btn-primary",
                        }
                    })
                }
           
        }

    </script>
</body>
</html>
